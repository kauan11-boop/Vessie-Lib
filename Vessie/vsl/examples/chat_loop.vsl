# ============================================================
# Exemplo: chat_loop.vsl
# Demonstra loop, variáveis, streaming e condicionais.
# Executa: node Vessie/index.js vsl Vessie/vsl/examples/chat_loop.vsl
# ============================================================

config {
  url = "http://localhost:1234/v1"
  temperature = 0.7
  topP = 0.95
  stream = true
}

set $topic = "programação em Python"
set $max_turns = 3

print "Iniciando conversa sobre: "
print $topic

loop $max_turns {
  send "Conte uma curiosidade sobre "
  # Concatena variável dinamicamente não é suportado,
  # então usamos uma mensagem fixa como demonstração
}

# Exemplo com streaming
send "Explique o que é recursão em 2 frases."
receive stream

# Exemplo de condicional
if $this_history contains "recursão" {
  print "✅ Tópico de recursão detectado na resposta!"
}

# Exemplo de batch
batch {
  send "Qual é a diferença entre lista e tupla em Python?"
  receive
}
